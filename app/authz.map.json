{
  "/api/auth/pending-status": {
    "description": "Any authenticated user can check their pending status",
    "ALL": []
  },
  "/api/ai/chat": {
    "description": "AI chat - requires approved user",
    "ANY": ["admin", "user"]
  },
  "/api/ai/policies.*": {
    "description": "AI policies - requires approved user",
    "ANY": ["admin", "user"]
  },
  "/api/ai/insights.*": {
    "description": "AI insights - requires approved user",
    "ANY": ["admin", "user"]
  },
  "/api/admin/users.*": {
    "description": "User management - admin only",
    "ALL": ["admin"]
  },
  "/api/admin/roles.*": {
    "description": "Role management - admin only",
    "ALL": ["admin"]
  },
  "/api/admin/groups.*": {
    "description": "Group management - admin only",
    "ALL": ["admin"]
  },
  "/api/admin/sessions.*": {
    "description": "Session management - admin only",
    "ALL": ["admin"]
  },
  "/api/admin/events.*": {
    "description": "Security events - admin only",
    "ALL": ["admin"]
  },
  "/api/admin.*": { "ALL": ["admin"] },
  "/api/test": {
    "description": "Requires any authenticated user (not pending)",
    "ANY": ["admin", "user"]
  },
  "/api/items.*": {
    "description": "Item CRUD operations - requires approved user",
    "ANY": ["admin", "user"]
  },
  "/api/agent/sync.*": {
    "description": "Trigger a refresh from Supervity Auto - admin only",
    "ALL": ["admin"]
  },
  "/api/agent/workflows/.*/execute": {
    "description": "Triggering an Auto workflow run - admin only",
    "ALL": ["admin"]
  },
  "/api/policies/.*/reset": {
    "description": "Resetting a policy to defaults - admin only",
    "ALL": ["admin"]
  },
  "/api/policies.*": {
    "description": "AI Policies - view and edit governance rules",
    "ANY": ["admin", "user"]
  },
  "/api/manager.*": {
    "description": "AI Manager - question and answer over the operation",
    "ANY": ["admin", "user"]
  },
  "/api/insights.*": {
    "description": "AI Insights - observations from Operator findings",
    "ANY": ["admin", "user"]
  },
  "/api/business.*": {
    "description": "Business outcome metrics",
    "ANY": ["admin", "user"]
  },
  "/api/integrations.*": {
    "description": "Data Manager - live integration health",
    "ANY": ["admin", "user"]
  },
  "/api/workbench.*": {
    "description": "Workbench - human-in-the-loop exception queue",
    "ANY": ["admin", "user"]
  },
  "/api/elimination.*": {
    "description": "Elimination Backlog - ranked ticket classes from Operator findings",
    "ANY": ["admin", "user"]
  },
  "/api/agent.*": {
    "description": "Read live agent activity from Supervity Auto",
    "ANY": ["admin", "user"]
  },

  "/api/documents/{document_id}": {
    "description": "Scenario 1: Ownership Check", "ANY": [ "admin", { "claims": { "sub": "{context.resource.owner_id}" } }]
  },
  "/api/purchase_orders/approve": {
    "description": "Scenario 2: Data-Driven Limits", "ALL": [ "manager", { "claims_lte": { "approval_limit": "{context.request.amount}" } }]
  },
  "/api/analytics/{region}": {
    "description": "Scenario 3: Hierarchical Constraint", "ALL": [ "regional-manager", { "claims": { "region": "{path.region}" } }]
  },
  "/api/articles/{article_id}/publish": {
    "description": "Scenario 4: Status-Based Transition", "ALL": [ "editor", { "claims": { "{context.resource.status}": "reviewed" } } ]
  },
  "/api/tenants/{tenant_id}/customers": {
    "description": "Scenario 5: Multi-Tenancy Isolation", "ALL": [ { "claims": { "tenant_id": "{path.tenant_id}" } } ]
  },
  "/api/secure-asset": {
    "description": "Scenario 6: Geofencing", "ALL": [ { "claims": { "{context.environment.source_country}": "US" } } ]
  },
  "/api/contractor/access": {
    "description": "Scenario 7: Time-Based Access", "ALL": [ "contractor", { "claims_gte": { "{context.environment.hour_utc}": 9 } }, { "claims_lte": { "{context.environment.hour_utc}": 17 } } ]
  },
  "/api/projects/{project_id}/delete": {
    "description": "Scenario 8: Step-Up Authentication", "ALL": [ "admin", { "claims_timediff_lte": { "mfa_authenticated_at": 300 } } ]
  },
  "/api/files/upload": {
    "description": "Scenario 9: Quota/Usage Limit", "ALL": [ "premium-user", { "claims_lte": { "{context.usage.total_after_upload}": "{user.storage_quota}" } } ]
  },
  "/api/records/{record_id}": {
    "description": "Scenario 10: Relationship-Based Access", "ANY": [ { "claims": { "sub": "{context.resource.patient_id}" } }, { "claims_contains": { "{context.resource.authorized_practitioners}": "{user.sub}" } } ]
  }
}